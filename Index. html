<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A Special Proposal for Devid Sunny ❤️</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
      font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      color: #fff;
      position: relative;
    }

    /* Floating Heart Particles */
    .bg-heart {
      position: absolute;
      color: rgba(255, 117, 151, 0.25);
      animation: floatUp 8s linear infinite;
      font-size: 20px;
      z-index: 1;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(100vh) scale(0.5) rotate(0deg);
        opacity: 0;
      }
      50% {
        opacity: 0.8;
      }
      100% {
        transform: translateY(-10vh) scale(1.2) rotate(360deg);
        opacity: 0;
      }
    }

    /* Card Container with Glassmorphism */
    .card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 45px 35px;
      border-radius: 28px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.15);
      text-align: center;
      max-width: 440px;
      width: 90%;
      position: relative;
      z-index: 10;
    }

    .heart-icon {
      font-size: 70px;
      animation: beat 1.1s infinite ease-in-out;
      display: inline-block;
      margin-bottom: 10px;
      filter: drop-shadow(0 0 10px rgba(255, 117, 151, 0.6));
    }

    @keyframes beat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.18); }
    }

    h1 {
      color: #ff7597;
      font-size: 28px;
      margin-bottom: 8px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .subtitle {
      color: #ffd1dc;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 22px;
      font-weight: 600;
    }

    p {
      color: #e0e0e0;
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 25px;
    }

    .highlight {
      color: #ff7597;
      font-weight: 700;
      text-shadow: 0 0 8px rgba(255, 117, 151, 0.3);
    }

    /* Interactive Buttons */
    .btn-container {
      display: flex;
      justify-content: center;
      gap: 15px;
      min-height: 55px;
      position: relative;
      margin-top: 15px;
    }

    button {
      padding: 14px 30px;
      font-size: 16px;
      font-weight: bold;
      border: none;
      border-radius: 30px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .yes-btn {
      background: linear-gradient(45deg, #ff4d6d, #ff7597);
      color: white;
      box-shadow: 0 5px 20px rgba(255, 77, 109, 0.5);
    }

    .yes-btn:hover {
      transform: scale(1.08);
      box-shadow: 0 8px 25px rgba(255, 77, 109, 0.8);
    }

    .no-btn {
      background-color: rgba(255, 255, 255, 0.85);
      color: #333;
      position: absolute;
      transition: all 0.2s ease;
    }

    /* Success Screen */
    .success-message {
      display: none;
      color: #ff7597;
      font-size: 22px;
      font-weight: bold;
      margin-top: 15px;
      line-height: 1.5;
      animation: fadeIn 0.8s forwards ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <!-- Card Container -->
  <div class="card">
    <div class="heart-icon">💖</div>
    <h1>Hey, Devid Sunny!</h1>
    <div class="subtitle">A Special Message Just For You</div>
    
    <p>
      From memories in <span class="highlight">Kothagudem</span> to those special days at <span class="highlight">GPT Kothagudem</span>, having you in my life makes every moment sweeter! ✨
      <br><br>
      Will you make my day and go out with me? 😊
    </p>

    <div class="btn-container" id="btnGroup">
      <button class="yes-btn" onclick="sayYes()">Yes! 🥰</button>
      <button class="no-btn" id="noBtn" onmouseover="moveNoButton()" onclick="moveNoButton()">No 😜</button>
    </div>

    <div class="success-message" id="successMsg">
      Yay Devid Sunny! 🎉❤️<br>
      I knew you'd say YES! Can't wait! ✨
    </div>
  </div>

  <script>
    // Create animated floating hearts in background
    function createHearts() {
      for (let i = 0; i < 20; i++) {
        const heart = document.createElement('div');
        heart.classList.add('bg-heart');
        heart.innerHTML = '❤️';
        heart.style.left = Math.random() * 100 + 'vw';
        heart.style.animationDuration = (Math.random() * 5 + 5) + 's';
        heart.style.fontSize = (Math.random() * 20 + 10) + 'px';
        document.body.appendChild(heart);
      }
    }
    createHearts();

    // Make the "No" button run away dynamically
    function moveNoButton() {
      const noBtn = document.getElementById('noBtn');
      const padding = 60;
      const x = Math.random() * (window.innerWidth - noBtn.offsetWidth - padding);
      const y = Math.random() * (window.innerHeight - noBtn.offsetHeight - padding);
      
      noBtn.style.position = 'fixed';
      noBtn.style.left = `${Math.max(padding, x)}px`;
      noBtn.style.top = `${Math.max(padding, y)}px`;
    }

    // Handle "Yes" click event
    function sayYes() {
      document.getElementById('btnGroup').style.display = 'none';
      document.getElementById('successMsg').style.display = 'block';
    }
  </script>

</body>
</html>
