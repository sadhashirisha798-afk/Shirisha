<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sunny | Student Profile</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: Arial, sans-serif;

    background:
    linear-gradient(135deg, #dff6ff, #ffffff, #e8f5e9);

    display: flex;
    justify-content: center;
    align-items: center;
}

.card {
    width: 92%;
    max-width: 430px;
    background: rgba(255,255,255,0.95);
    border-radius: 30px;
    padding: 30px;
    text-align: center;

    box-shadow: 0 18px 50px rgba(0,0,0,0.16);
}

.top {
    color: #1261a0;
    font-size: 14px;
    letter-spacing: 1px;
    margin-bottom: 20px;
}

.photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;

    margin: auto;

    background: #e3f2fd;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 55px;

    border: 5px solid #d5edf9;
}

h1 {
    color: #222;
    margin: 18px 0 5px;
    font-size: 32px;
}

.subtitle {
    color: #777;
    margin-bottom: 25px;
}

.info {
    text-align: left;
}

.row {
    background: #f7fbfd;
    margin: 10px 0;
    padding: 13px 15px;
    border-radius: 13px;
}

.title {
    color: #777;
    font-size: 12px;
}

.value {
    color: #222;
    font-weight: bold;
    margin-top: 4px;
}

.quote {
    margin-top: 25px;
    padding: 18px;
    border-radius: 18px;
    background: #eef8ff;
    color: #555;
    line-height: 1.6;
    font-style: italic;
}

.back {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 22px;
    border-radius: 20px;
    background: #1261a0;
    color: white;
    text-decoration: none;
}

.back:hover {
    background: #0b4778;
}
</style>
</head>

<body>

<div class="card">

    <div class="top">
        GOVT POLYTECHNIC KOTHAGUDEM
    </div>
  
    <img src ="sunny9.jpg" height="300" width="200">

    <div class="photo">
     
        👨‍🎓
    </div>

    <h1>Sunny</h1>

    <div class="subtitle">
        Civil Engineering Student
    </div>

    <div class="info">

        <div class="row">
            <div class="title">NAME</div>
            <div class="value">Sunny</div>
        </div>

        <div class="row">
            <div class="title">PLACE</div>
            <div class="value">Kothagudem</div>
        </div>

        <div class="row">
            <div class="title">BRANCH</div>
            <div class="value">Civil Engineering</div>
        </div>

        <div class="row">
            <div class="title">BATCH</div>
            <div class="value">2022 - 2026</div>
        </div>

        <div class="row">
            <div class="title">PIN NUMBER</div>
            <div class="value">22046-CE-018</div>
        </div>

    </div>

    <div class="quote">
        “Every journey begins with a dream,
        and every dream begins with a first step. ✨”
    </div>

    
        
    

</div>

</body>
</html>
